#!/usr/bin/env bash
set -euo pipefail

source /etc/todo-mongo-backup.env
timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
archive="${BACKUP_DIR}/${timestamp}.archive.gz"
temporary="${archive}.tmp"

mongodump --uri="$MONGODB_URI" --archive="$temporary" --gzip
mv "$temporary" "$archive"
find "$BACKUP_DIR" -type f -name '*.archive.gz' -mtime "+${BACKUP_RETENTION_DAYS}" -delete
